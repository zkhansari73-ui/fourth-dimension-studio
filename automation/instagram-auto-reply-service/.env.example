# Safe by default: no Instagram reply is sent while DRY_RUN=true.
PORT=8787
DRY_RUN=true
INGEST_MODE=poll
POLL_INTERVAL_SECONDS=60
MAX_PAGES_PER_POLL=10

# Composio project/account
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=pg-test-a758729a-4537-409d-81f5-999891ebd67a
COMPOSIO_CONNECTED_ACCOUNT_ID=ca_zxlQN-6Mlyz_
COMPOSIO_INSTAGRAM_VERSION=20260915_00

# Connected Instagram professional account
INSTAGRAM_ACCOUNT_ID=39109250795339859

# Meta webhook security. Only required when INGEST_MODE=webhook.
# Generate a long random META_VERIFY_TOKEN.
META_VERIFY_TOKEN=
META_APP_SECRET=
ALLOW_UNSIGNED_WEBHOOKS=false

# Local configuration/state
REPLY_CONFIG_PATH=./config/replies.json
STATE_PATH=./data/state.json
MAX_REPLY_ATTEMPTS=5
