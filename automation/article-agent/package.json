{
  "name": "fourth-dimension-article-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent, approval-gated multilingual article automation for Fourth Dimension Studio.",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/run.js",
    "publish-approved": "node --env-file-if-exists=.env src/publish-approved.js",
    "test": "node --test",
    "check": "node --check src/run.js && node --check src/publish-approved.js && node --test"
  },
  "dependencies": {
    "@composio/core": "0.21.0",
    "fast-xml-parser": "5.2.5"
  }
}
